{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-controls",
  "description": "Only bundled controller and browser toolbar can control navigation. No remote origins or window-wide grants.",
  "local": true,
  "webviews": ["controller", "browser-toolbar"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-browser-snapshot",
    "allow-open-browser",
    "allow-navigate-browser",
    "allow-browser-action"
  ]
}
